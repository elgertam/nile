{
  "name": "nile-ts",
  "version": "0.1.0",
  "description": "Nile language implemented in TypeScript with Ohm/JS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prepare": "npm run clean && npm run build"
  },
  "keywords": [
    "nile",
    "language",
    "compiler",
    "interpreter",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ohm-js": "^16.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.1",
    "@types/node": "^20.2.5",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.42.0",
    "jest": "^29.5.0",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.3"
  }
}
